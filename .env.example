# PostgreSQL connection
DATABASE_URL="postgresql://assembly:assembly@localhost:5432/assembly_os?schema=public"

# Session signing secret (min. 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-with-at-least-32-chars"

# Document storage: "local" (default, ./storage/uploads) or "s3" (prepared, not implemented in MVP)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"

# AI provider: "demo" (default, simulated, no external calls) or "anthropic"
AI_PROVIDER="demo"
# Only required when AI_PROVIDER="anthropic". Never commit real keys.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
